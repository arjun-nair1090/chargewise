# Copy to .env and replace every placeholder. Never commit .env.

# PostgreSQL (used by docker-compose.yml)
POSTGRES_DB=chargewise
POSTGRES_USER=chargewise
POSTGRES_PASSWORD=change-me
# Host port for the database; change it if 5432 is already in use locally
CHARGEWISE_DB_PORT=5432

# Backend
CHARGEWISE_DB_URL=jdbc:postgresql://localhost:5432/chargewise
CHARGEWISE_DB_USER=chargewise
CHARGEWISE_DB_PASSWORD=change-me
# At least 32 random bytes, e.g. `openssl rand -base64 48`
CHARGEWISE_JWT_SECRET=replace-with-at-least-32-random-bytes
# Optional: creates an OPERATOR account at startup if it does not exist
CHARGEWISE_BOOTSTRAP_OPERATOR_EMAIL=
CHARGEWISE_BOOTSTRAP_OPERATOR_PASSWORD=

# Demo data (synthetic). Password shared by every @demo.chargewise.test account the seeder creates
CHARGEWISE_DEMO_PASSWORD=
# true = replace operational data with datasets/*.json at startup
CHARGEWISE_DEMO_SEED_ON_STARTUP=false

# Simulated charging lifecycle: advances sessions every 60 s (false = off)
CHARGEWISE_LIFECYCLE_ENABLED=true
